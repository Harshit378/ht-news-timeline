{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./apps/web/*"],
      "@ht/shared/*": ["./libs/shared/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "apps/web/app/**/*.ts",
    "apps/web/app/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/api", "dist", ".nx"]
}
