<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain-HTTP calls to a local dev API (e.g. http://192.168.1.20:4000/api).
     Release builds keep Android's default HTTPS-only policy. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:usesCleartextTraffic="true" tools:ignore="UnusedAttribute" />
</manifest>
