{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "command": "npm ci", "cwd": "apps/mobile" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "npx expo start", "cwd": "apps/mobile" }
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": { "command": "npx expo start --ios", "cwd": "apps/mobile" }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": { "command": "npx expo start --android", "cwd": "apps/mobile" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npx tsc --noEmit", "cwd": "apps/mobile" }
    },
    "bundle-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "EXPO_NO_TELEMETRY=1 CI=1 npx expo export --platform ios --platform android --output-dir dist-check && rm -rf dist-check",
        "cwd": "apps/mobile"
      }
    }
  }
}
