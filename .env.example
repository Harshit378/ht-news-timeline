# Homebrew postgres@16 or `docker compose up -d` — same credentials. Run `pnpm db:deploy` after setting it.
# connection_limit/pool_timeout size Prisma's pool; behind PgBouncer/Neon pooled URLs also add &pgbouncer=true.
DATABASE_URL="postgresql://timeline:timeline@localhost:5432/timeline?schema=public&connection_limit=10&pool_timeout=20"
PORT=4000
# Production browser origins (comma-separated). capacitor://localhost and http://localhost are always allowed;
# outside production any localhost / 127.0.0.1 / LAN origin on any port is allowed too.
CORS_ORIGIN=http://localhost:3000
# Must include the /api prefix. Native builds need a reachable host, e.g. http://192.168.1.20:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/events
# AI summaries (ADR-004). LLM_PROVIDER: ollama (local, default) | none. Cloud providers come later.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_MS=120000
# Future cloud provider (not used yet)
GEMINI_API_KEY=
