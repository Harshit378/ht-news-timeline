# Homebrew postgres@16 or `docker compose up -d` — same credentials. Run `pnpm db:deploy` after setting it.
# connection_limit/pool_timeout size Prisma's pool; behind PgBouncer/Neon pooled URLs also add &pgbouncer=true.
DATABASE_URL="postgresql://timeline:timeline@localhost:5432/timeline?schema=public&connection_limit=10&pool_timeout=20"
PORT=4000
# Production browser origins (comma-separated). capacitor://localhost and http://localhost are always allowed;
# outside production any localhost / 127.0.0.1 / LAN origin on any port is allowed too.
CORS_ORIGIN=http://localhost:3000
# Must include the /api prefix. Native builds need a reachable host, e.g. http://192.168.1.20:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/events
# AI summaries (ADR-004). LLM_PROVIDER: ollama (local, default) | anthropic | none.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_MS=120000
# LLM_PROVIDER=anthropic: key (or ANTHROPIC_AUTH_TOKEN / `ant auth login`), model and effort.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
# Global daily cap on cloud LLM tokens (input + output, UTC day). 0 = unlimited.
LLM_DAILY_TOKEN_LIMIT=2000000

# Live events (ADR-005). Bearer token for POST /api/events (required in production).
EVENTS_ADMIN_TOKEN=
# Set when running more than one API instance: `docker compose --profile scale up -d`.
REDIS_URL=

# News Search API (ADR-008 step 3, TheNewsAPI format). Off while NEWS_API_KEY is empty.
NEWS_API_KEY=
NEWS_API_DAILY_LIMIT=100
NEWS_API_PAGE_SIZE=25

# Wikipedia milestones on story timelines (ADR-008 step 6). Wikimedia asks for contact info in the User-Agent.
WIKIMEDIA_CONTACT=
WIKIMEDIA_MILESTONES=on
